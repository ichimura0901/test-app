{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Streamlit",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/src/main.py",
                "--server.port=8502",
                "--server.headless=true",
                "--server.runOnSave=true"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}