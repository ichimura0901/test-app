{
    "name": "My Dev Container",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "../"
    },
    "postStartCommand": "mkdir -p ~/.streamlit && echo '[general]\nemail = \"\"' > ~/.streamlit/credentials.toml && streamlit run src/main.py --server.port 8501 --server.address 0.0.0.0",
    "forwardPorts": [
        8501
    ],
    "customizations": {
        "vscode": {
            "settings": {},
            "extensions": [
                "ms-ceintl.vscode-language-pack-ja",
                "ms-python.python",
                "charliermarsh.ruff",
                "ms-azuretools.vscode-containers",
                "njpwerner.autodocstring"
            ]
        }
    },
    "features": {
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
            "version": "latest",
            "moby": false
        }
    }
}